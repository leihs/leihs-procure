#!/usr/bin/env bash
set -euo pipefail

apt update --yes
apt dist-upgrade --yes

apt install --yes \
  git \
  curl

# GitHub intermittently answers anonymous HTTPS clones from CI hosts with
# 401 ("could not read Username"); retry with backoff instead of failing the
# whole container build on the first attempt.
export GIT_TERMINAL_PROMPT=0
for attempt in 1 2 3 4 5; do
  if git clone --depth 1 --branch v0.14.0 https://github.com/asdf-vm/asdf.git ~/.asdf; then
    break
  fi
  rm -rf ~/.asdf
  if [ "$attempt" = 5 ]; then echo "ERROR: cloning asdf failed after 5 attempts"; exit 1; fi
  sleep $((attempt * 15))
done

echo '. "$HOME/.asdf/asdf.sh"' >> ~/.bashrc
echo '. "$HOME/.asdf/completions/asdf.bash"' >> ~/.bashrc

cat ~/.bashrc

# vi set ft=sh
